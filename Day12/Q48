
#include <stdio.h>

int is_perfect(int n) {
    if (n <= 1) {
        return 0;
    }
    
    int sum = 1;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            sum += i;
            if (i * i != n) {
                sum += n / i;
            }
        }
    }
    return sum == n;
}

int main() {
    int num = 28;
    if (is_perfect(num)) {
        printf("Perfect Number\n");
    } else {
        printf("Not a Perfect Number\n");
    }
    return 0;
}