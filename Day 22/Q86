
#include <stdio.h>

int main() {
    char str[200];
    int i = 0, count = 1;

    fgets(str, sizeof(str), stdin);

    while (str[i] != '\0') {
        if (str[i] == ' ' && str[i + 1] != ' ' && str[i + 1] != '\0')
            count++;
        i++;
    }

    printf("%d", count);

    return 0;
}

