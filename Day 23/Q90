#include <stdio.h>

int main() {
    char str[100];
    int freq[256] = {0};
    int i;

    scanf("%s", str);

    for (i = 0; str[i] != '\0'; i++) {
        if (freq[(unsigned char)str[i]] == 1) {
            printf("%c", str[i]);
            return 0;
        }
        freq[(unsigned char)str[i]]++;
    }

    printf("No repeating character");

    return 0;
}