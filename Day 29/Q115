#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100], temp[200];
    int choice, len;

    do {
        printf("\n1. Find Length");
        printf("\n2. Copy String");
        printf("\n3. Concatenate");
        printf("\n4. Compare");
        printf("\n5. Reverse");
        printf("\n6. Exit\n");

        scanf("%d", &choice);

        switch (choice) {
            case 1:
                scanf("%s", str1);
                len = strlen(str1);
                printf("Length = %d", len);
                break;

            case 2:
                scanf("%s", str1);
                strcpy(temp, str1);
                printf("Copied String = %s", temp);
                break;

            case 3:
                scanf("%s %s", str1, str2);
                strcat(str1, str2);
                printf("Concatenated String = %s", str1);
                break;

            case 4:
                scanf("%s %s", str1, str2);
                if (strcmp(str1, str2) == 0)
                    printf("Strings are Equal");
                else
                    printf("Strings are Not Equal");
                break;

            case 5:
                {
                    int i, j;
                    scanf("%s", str1);
                    len = strlen(str1);

                    for (i = 0, j = len - 1; i < j; i++, j--) {
                        char ch = str1[i];
                        str1[i] = str1[j];
                        str1[j] = ch;
                    }

                    printf("Reverse = %s", str1);
                }
                break;

            case 6:
                printf("Exit");
                break;

            default:
                printf("Invalid Choice");
        }

    } while (choice != 6);

    return 0;
}