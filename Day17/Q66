#include <stdio.h>

int main() {
    int arr1[] = {1, 3, 4, 5, 7};
    int n1 = sizeof(arr1) / sizeof(arr1[0]);

    int arr2[] = {2, 3, 5, 6, 8};
    int n2 = sizeof(arr2) / sizeof(arr2[0]);

    int i, j, isDuplicate;

    printf("Union of the two arrays: ");

    for (i = 0; i < n1; i++) {
        printf("%d ", arr1[i]);
    }

    for (i = 0; i < n2; i++) {
        isDuplicate = 0;

        for (j = 0; j < n1; j++) {
            if (arr2[i] == arr1[j]) {
                isDuplicate = 1;
                break;
            }
        }

        if (!isDuplicate) {
            printf("%d ", arr2[i]);
        }
    }
    printf("\n");

    return 0;
}