
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int new_size = 0; // Tracks the size of the array without duplicates

    for (int i = 0; i < n; i++) {
        int is_duplicate = 0;
        
        // Check if the current element has already been encountered
        for (int j = 0; j < new_size; j++) {
            if (arr[i] == arr[j]) {
                is_duplicate = 1;
                break;
            }
        }

        // If it's a unique element, shift it to the front
        if (!is_duplicate) {
            arr[new_size] = arr[i];
            new_size++;
        }
    }

    // Print the array with unique elements
    for (int i = 0; i < new_size; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}