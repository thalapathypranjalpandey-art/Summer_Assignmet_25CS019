#include <stdio.h>

int main() {
    int choice, score = 0;

    printf("1. What is the capital of India?\n");
    printf("1. Mumbai\n2. Delhi\n3. Kolkata\n4. Chennai\n");
    scanf("%d", &choice);

    if (choice == 2)
        score++;

    printf("\n2. Which language is used for C programming?\n");
    printf("1. Python\n2. Java\n3. C\n4. HTML\n");
    scanf("%d", &choice);

    if (choice == 3)
        score++;

    printf("\n3. Which is the largest planet?\n");
    printf("1. Earth\n2. Mars\n3. Jupiter\n4. Venus\n");
    scanf("%d", &choice);

    if (choice == 3)
        score++;

    printf("\n4. How many days are there in a week?\n");
    printf("1. 5\n2. 6\n3. 7\n4. 8\n");
    scanf("%d", &choice);

    if (choice == 3)
        score++;

    printf("\n5. Which symbol is used to end a statement in C?\n");
    printf("1. .\n2. ;\n3. :\n4. ,\n");
    scanf("%d", &choice);

    if (choice == 2)
        score++;

    printf("\nYour Score = %d/5", score);

    if (score == 5)
        printf("\nExcellent!");
    else if (score >= 3)
        printf("\nGood!");
    else
        printf("\nNeed more practice!");

    return 0;
}