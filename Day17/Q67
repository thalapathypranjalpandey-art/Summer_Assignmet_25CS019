#include <stdio.h>

int main() {
    int arr1[] = {1, 3, 4, 5, 7, 3};
    int n1 = sizeof(arr1) / sizeof(arr1[0]);

    int arr2[] = {2, 3, 5, 6, 3, 8};
    int n2 = sizeof(arr2) / sizeof(arr2[0]);

    int i, j, k;

    printf("Intersection of the two arrays: ");

    for (i = 0; i < n1; i++) {
        int isAlreadyPrinted = 0;
        for (k = 0; k < i; k++) {
            if (arr1[i] == arr1[k]) {
                isAlreadyPrinted = 1;
                break;
            }
        }

        if (!isAlreadyPrinted) {
            for (j = 0; j < n2; j++) {
                if (arr1[i] == arr2[j]) {
                    printf("%d ", arr1[i]);
                    break;
                }
            }
        }
    }
    printf("\n");

    return 0;
}