#include <stdio.h>

int main() {
    int a[100], n, i, choice, pos, value, found;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    do {
        printf("\n1. Display");
        printf("\n2. Insert");
        printf("\n3. Delete");
        printf("\n4. Search");
        printf("\n5. Update");
        printf("\n6. Exit\n");

        scanf("%d", &choice);

        switch (choice) {
            case 1:
                for (i = 0; i < n; i++)
                    printf("%d ", a[i]);
                break;

            case 2:
                printf("Enter position and value: ");
                scanf("%d %d", &pos, &value);

                for (i = n; i > pos; i--)
                    a[i] = a[i - 1];

                a[pos] = value;
                n++;
                break;

            case 3:
                printf("Enter position: ");
                scanf("%d", &pos);

                for (i = pos; i < n - 1; i++)
                    a[i] = a[i + 1];

                n--;
                break;

            case 4:
                printf("Enter value to search: ");
                scanf("%d", &value);

                found = 0;

                for (i = 0; i < n; i++) {
                    if (a[i] == value) {
                        printf("Found at position %d", i);
                        found = 1;
                        break;
                    }
                }

                if (!found)
                    printf("Not found");
                break;

            case 5:
                printf("Enter position and new value: ");
                scanf("%d %d", &pos, &value);

                a[pos] = value;
                break;

            case 6:
                printf("Exit");
                break;

            default:
                printf("Invalid choice");
        }

    } while (choice != 6);

    return 0;
}