#include <stdio.h>
#include <string.h>

struct Book {
    int id;
    char name[50];
    char author[50];
    int issued;
};

int main() {
    struct Book b[100];
    int n, i, choice;

    printf("Enter number of books: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter book id: ");
        scanf("%d", &b[i].id);

        printf("Enter book name: ");
        scanf("%s", b[i].name);

        printf("Enter author name: ");
        scanf("%s", b[i].author);

        b[i].issued = 0;
    }

    do {
        printf("\n1. Display Books");
        printf("\n2. Issue Book");
        printf("\n3. Return Book");
        printf("\n4. Search Book");
        printf("\n5. Exit\n");

        scanf("%d", &choice);

        switch (choice) {
            case 1:
                for (i = 0; i < n; i++) {
                    printf("\nID: %d", b[i].id);
                    printf("\nName: %s", b[i].name);
                    printf("\nAuthor: %s", b[i].author);
                    printf("\nStatus: %s\n", b[i].issued ? "Issued" : "Available");
                }
                break;

            case 2:
                {
                    int id, found = 0;
                    scanf("%d", &id);

                    for (i = 0; i < n; i++) {
                        if (b[i].id == id) {
                            if (b[i].issued == 0) {
                                b[i].issued = 1;
                                printf("Book issued");
                            } else {
                                printf("Book already issued");
                            }
                            found = 1;
                            break;
                        }
                    }

                    if (!found)
                        printf("Book not found");
                }
                break;

            case 3:
                {
                    int id, found = 0;
                    scanf("%d", &id);

                    for (i = 0; i < n; i++) {
                        if (b[i].id == id) {
                            b[i].issued = 0;
                            printf("Book returned");
                            found = 1;
                            break;
                        }
                    }

                    if (!found)
                        printf("Book not found");
                }
                break;

            case 4:
                {
                    int id, found = 0;
                    scanf("%d", &id);

                    for (i = 0; i < n; i++) {
                        if (b[i].id == id) {
                            printf("Book: %s\nAuthor: %s", b[i].name, b[i].author);
                            found = 1;
                            break;
                        }
                    }

                    if (!found)
                        printf("Book not found");
                }
                break;

            case 5:
                printf("Exit");
                break;

            default:
                printf("Invalid choice");
        }

    } while (choice != 5);

    return 0;
}