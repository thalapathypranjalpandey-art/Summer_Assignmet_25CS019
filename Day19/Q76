#include <stdio.h>

int main() {
    int n = 3;
    int i, j;

    int matrix[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    int principal_sum = 0;
    int secondary_sum = 0;

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (i == j) {
                principal_sum += matrix[i][j];
            }

            if ((i + j) == (n - 1)) {
                secondary_sum += matrix[i][j];
            }
        }
    }

    printf("Sum of Principal Diagonal: %d\n", principal_sum);
    printf("Sum of Secondary Diagonal: %d\n", secondary_sum);

    return 0;
}